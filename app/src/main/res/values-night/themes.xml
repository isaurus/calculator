<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for dark mode -->
    <style name="Theme.Calculator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary color (used for key components like FAB, buttons, etc.) -->
        <item name="colorPrimary">@color/number_button_background</item>
        <item name="colorOnPrimary">@color/number_button_text</item>

        <!-- Secondary color (used for less prominent UI elements) -->
        <item name="colorSecondary">@color/operation_button_background</item>
        <item name="colorOnSecondary">@color/operation_button_text</item>

        <!-- Background color (main background of the app) -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/number_button_text</item>

        <!-- Error color (used for error states, like the AC button) -->
        <item name="colorError">@color/ac_button_background</item>
        <item name="colorOnError">@color/ac_button_text</item>

        <!-- Success color (used for the equals button) -->
        <item name="colorTertiary">@color/equals_button_background</item>
        <item name="colorOnTertiary">@color/equals_button_text</item>
    </style>
</resources>