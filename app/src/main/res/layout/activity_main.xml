<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mainToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/main_menu"
        app:title="" />

    <EditText
        android:id="@+id/edtOperation"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:inputType="none"
        android:textAlignment="viewEnd"
        android:textIsSelectable="true"
        android:textSize="24dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mainToolbar" />

    <TextView
        android:id="@+id/txtResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center|end"
        android:hint="0"
        android:textSize="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtOperation" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtResult">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAC"
            style="@style/ACButton"
            android:text="AC"
            app:layout_constraintBottom_toTopOf="@+id/btnSeven"
            app:layout_constraintEnd_toEndOf="@+id/btnSeven"
            app:layout_constraintStart_toStartOf="@+id/btnSeven" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemainder"
            style="@style/OperationButton"
            android:text="%"
            app:layout_constraintBottom_toTopOf="@+id/btnEight"
            app:layout_constraintEnd_toEndOf="@+id/btnEight"
            app:layout_constraintStart_toStartOf="@+id/btnEight" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErase"
            style="@style/OperationButton"
            android:text="C"
            app:layout_constraintBottom_toTopOf="@+id/btnNine"
            app:layout_constraintEnd_toEndOf="@+id/btnNine"
            app:layout_constraintStart_toStartOf="@+id/btnNine" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDivide"
            style="@style/OperationButton"
            android:text="/"
            app:layout_constraintBottom_toTopOf="@+id/btnMultiplicate"
            app:layout_constraintEnd_toEndOf="@+id/btnMultiplicate"
            app:layout_constraintStart_toStartOf="@+id/btnMultiplicate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeven"
            style="@style/NumberButton"
            android:text="7"
            app:layout_constraintBottom_toTopOf="@+id/btnFour"
            app:layout_constraintEnd_toEndOf="@+id/btnFour"
            app:layout_constraintStart_toStartOf="@+id/btnFour" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEight"
            style="@style/NumberButton"
            android:text="8"
            app:layout_constraintBottom_toTopOf="@+id/btnFive"
            app:layout_constraintEnd_toEndOf="@+id/btnFive"
            app:layout_constraintStart_toStartOf="@+id/btnFive" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNine"
            style="@style/NumberButton"
            android:text="9"
            app:layout_constraintBottom_toTopOf="@+id/btnSix"
            app:layout_constraintEnd_toEndOf="@+id/btnSix"
            app:layout_constraintStart_toStartOf="@+id/btnSix" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMultiplicate"
            style="@style/OperationButton"
            android:text="x"
            app:layout_constraintBottom_toTopOf="@+id/btnSubstract"
            app:layout_constraintEnd_toEndOf="@+id/btnSubstract"
            app:layout_constraintStart_toStartOf="@+id/btnSubstract" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFour"
            style="@style/NumberButton"
            android:text="4"
            app:layout_constraintBottom_toTopOf="@+id/btnOne"
            app:layout_constraintEnd_toEndOf="@+id/btnOne"
            app:layout_constraintStart_toStartOf="@+id/btnOne" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFive"
            style="@style/NumberButton"
            android:text="5"
            app:layout_constraintBottom_toTopOf="@+id/btnTwo"
            app:layout_constraintEnd_toEndOf="@+id/btnTwo"
            app:layout_constraintStart_toStartOf="@+id/btnTwo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSix"
            style="@style/NumberButton"
            android:text="6"
            app:layout_constraintBottom_toTopOf="@+id/btnThree"
            app:layout_constraintEnd_toEndOf="@+id/btnThree"
            app:layout_constraintStart_toStartOf="@+id/btnThree" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubstract"
            style="@style/OperationButton"
            android:text="-"
            app:layout_constraintBottom_toTopOf="@+id/btnAdd"
            app:layout_constraintEnd_toEndOf="@+id/btnAdd"
            app:layout_constraintStart_toStartOf="@+id/btnAdd" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOne"
            style="@style/NumberButton"
            android:text="1"
            app:layout_constraintBottom_toTopOf="@+id/btn00"
            app:layout_constraintEnd_toEndOf="@+id/btn00"
            app:layout_constraintStart_toStartOf="@+id/btn00" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTwo"
            style="@style/NumberButton"
            android:text="2"
            app:layout_constraintBottom_toTopOf="@+id/btnCero"
            app:layout_constraintEnd_toEndOf="@+id/btnCero"
            app:layout_constraintStart_toStartOf="@+id/btnCero" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThree"
            style="@style/NumberButton"
            android:layout_marginBottom="15dp"
            android:text="3"
            app:layout_constraintBottom_toTopOf="@+id/btnDecimalPoint"
            app:layout_constraintEnd_toEndOf="@+id/btnDecimalPoint"
            app:layout_constraintStart_toStartOf="@+id/btnDecimalPoint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/OperationButton"
            android:layout_marginBottom="15dp"
            android:text="+"
            app:layout_constraintBottom_toTopOf="@+id/btnEquals"
            app:layout_constraintEnd_toEndOf="@+id/btnEquals"
            app:layout_constraintStart_toStartOf="@+id/btnEquals" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn00"
            style="@style/NumberButton"
            android:text="00"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/btnEquals"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCero"
            style="@style/NumberButton"
            android:text="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.330"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDecimalPoint"
            style="@style/NumberButton"
            android:layout_marginBottom="4dp"
            android:text=","
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/btnEquals"
            app:layout_constraintHorizontal_bias="0.670"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEquals"
            style="@style/EqualsButton"
            android:text="="
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>